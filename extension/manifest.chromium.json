{
  "manifest_version": 3,
  "name": "tailtab",
  "version": "0.1.0",
  "description": "Give this browser profile its own Tailscale node, without a system-wide VPN.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "proxy", "storage", "tabs", "alarms", "webRequest", "webRequestAuthProvider"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "tailtab",
    "default_icon": {
      "16": "icons/idle/icon16.png",
      "32": "icons/idle/icon32.png",
      "48": "icons/idle/icon48.png",
      "128": "icons/idle/icon128.png"
    }
  },
  "icons": {
    "16": "icons/brand/icon16.png",
    "32": "icons/brand/icon32.png",
    "48": "icons/brand/icon48.png",
    "128": "icons/brand/icon128.png"
  }
}
