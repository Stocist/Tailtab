{
  "comment": [
    "The split-tunnel decision table, shared by the two implementations of the",
    "rule: allowTailnetHost in internal/proxy (the host's guard) and",
    "tailtabIsTailnetHost in extension/rules.js (the browser's split tunnel, and",
    "the PAC script generated from it). Both are tested against this file, so a",
    "change to one without the other fails a test rather than showing up as a",
    "403 from the proxy on a host the extension decided to proxy.",
    "",
    "suffix is the node's own MagicDNS suffix as the implementation knows it at",
    "the time: empty before the node has reported a status, and a custom domain",
    "for a tailnet that does not use .ts.net.",
    "",
    "proxy is true when the host belongs to the tailnet and must go through the",
    "proxy, false when it must stay DIRECT and, on the host side, be refused."
  ],
  "cases": [
    { "host": "wiki", "suffix": "", "proxy": true, "why": "MagicDNS short name" },
    { "host": "server", "suffix": "", "proxy": true, "why": "MagicDNS short name" },
    { "host": "wiki.tail4d5e6f.ts.net", "suffix": "", "proxy": true, "why": "MagicDNS FQDN" },
    { "host": "host.tail1a2b3c.ts.net", "suffix": "", "proxy": true, "why": "another tailnet" },
    { "host": "WIKI.TAIL4D5E6F.TS.NET", "suffix": "", "proxy": true, "why": "case" },
    { "host": "wiki.tail4d5e6f.ts.net.", "suffix": "", "proxy": true, "why": "trailing dot" },
    { "host": "100.64.0.1", "suffix": "", "proxy": true, "why": "CGNAT, first" },
    { "host": "100.101.102.103", "suffix": "", "proxy": true, "why": "CGNAT" },
    { "host": "100.127.255.255", "suffix": "", "proxy": true, "why": "CGNAT, last" },
    { "host": "fd7a:115c:a1e0::1", "suffix": "", "proxy": true, "why": "Tailscale ULA" },
    { "host": "[fd7a:115c:a1e0:ab12::1]", "suffix": "", "proxy": true, "why": "bracketed" },
    { "host": "::ffff:100.64.0.1", "suffix": "", "proxy": true, "why": "v4-mapped CGNAT" },

    { "host": "", "suffix": "", "proxy": false, "why": "no host" },
    { "host": "github.com", "suffix": "", "proxy": false, "why": "the public internet" },
