    { "host": "host.my-tailnet.example.com", "suffix": "my-tailnet.example.com", "proxy": true, "why": "custom domain" },
    { "host": "deep.host.my-tailnet.example.com", "suffix": "my-tailnet.example.com", "proxy": true, "why": "custom domain, deeper" },
    { "host": "HOST.MY-TAILNET.EXAMPLE.COM", "suffix": "my-tailnet.example.com", "proxy": true, "why": "custom domain, case" },
