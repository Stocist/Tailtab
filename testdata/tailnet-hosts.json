    { "host": "wiki", "suffix": "my-tailnet.example.com", "proxy": true, "why": "short names still work" },
    { "host": "wiki.tail4d5e6f.ts.net", "suffix": "my-tailnet.example.com", "proxy": true, "why": "ts.net still works" },

    { "host": "wiki.tail4d5e6f.ts.net", "suffix": "tail4d5e6f.ts.net", "proxy": true, "why": "the phase-0 tailnets" },
    { "host": "tail4d5e6f.ts.net", "suffix": "tail4d5e6f.ts.net", "proxy": true, "why": "the suffix itself" },
    { "host": "github.com", "suffix": "tail4d5e6f.ts.net", "proxy": false, "why": "the public internet" }
  ]
}
